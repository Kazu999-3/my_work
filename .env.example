# ==============================================================================
# Sovereign OS 環境変数テンプレート (.env.example)
# ==============================================================================
# このファイルをコピーして `.env` または `04_PORTAL/.env.local` を作成してください。
# ※ 本番環境の機密情報（APIキー、パスワード）は絶対に Git コミットしないでください。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 外部通知・連携設定 (Notifications & Webhooks)
# ------------------------------------------------------------------------------
# Discord Webhook URL: セッション終了（/wrap-up）時の日次ナレッジ投稿やヘルスチェック異常通知に使用
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ------------------------------------------------------------------------------
# 2. Supabase データベース連携 (Portal & Backend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 3. AI / LLM ゲートウェイ設定 (Gemini & Multi-Model)
# ------------------------------------------------------------------------------
# Google Gemini API キー（複数キーのローテーション管理が可能）
GEMINI_API_KEY=your-gemini-api-key-here
# 必要に応じて予備キーを設定
# GEMINI_API_KEY_BACKUP_1=your-backup-key-1
# GEMINI_API_KEY_BACKUP_2=your-backup-key-2

# ------------------------------------------------------------------------------
# 4. Riot Games 公式 API 設定 (LoL Live Client & Match Data)
# ------------------------------------------------------------------------------
# Riot Games Developer Portal で発行した API キー (RGAPI-xxxx)
RIOT_API_KEY=RGAPI-your-riot-api-key-here
# プレイ環境のリージョン (jp1, kr, na1 等)
RIOT_REGION=jp1

# ------------------------------------------------------------------------------
# 5. YouTube 監視・分析設定 (Data API v3)
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=your-youtube-api-key-here

# ------------------------------------------------------------------------------
# 6. ポータル運用・認証設定 (Admin Authentication)
# ------------------------------------------------------------------------------
# ポータル管理者パスワード
ADMIN_SECRET=your-secure-admin-password
NEXTAUTH_SECRET=your-nextauth-secret-string
NEXTAUTH_URL=http://localhost:3000
